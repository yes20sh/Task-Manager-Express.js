<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>
<div class="main w-full min-h-screen p-10 bg-zinc-900 text-white">
    <a class="mt-5 bg-blue-800 rounded-md px-5 py-2" href="/">back</a>
    <div class="form">
        <form action="/create" method="post" class="p-10 text-white">
            
            <input class="block w-full rounded-lg py-2 px-5 bg-zinc-800" type="text", placeholder="Previous name" name="previous" value="<%= previousfile %>">
           
            <input class="block w-full rounded-lg py-2 px-5 mt-5 bg-zinc-800" type="text", placeholder="New Name" name="new">            
            <input class="mt-5 bg-yellow-600 rounded-md px-5 py-2" type="submit" value="Update">
        </form>
     </div>
 
</div>
</body>
</html>