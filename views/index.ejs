<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>
 <div class="main w-full min-h-screen bg-zinc-900">
 <div class="form">
    <form action="/create" method="post" class="p-10 text-white">
        <input class="block w-full rounded-lg px-5 py-2 bg-zinc-800" type="text", placeholder="Title" name="title">
        <textarea class="block w-full rounded-lg mt-5 px-5 py-2 resize-none bg-zinc-800" placeholder="Description" name="details"></textarea>
        <input class="mt-5 bg-blue-600 rounded-md px-5 py-2" type="submit" value="create task">
    </form>
 </div>
 <h1 class="my-5 px-10 text-white text-3xl">Tasks</h1>
 <div class="tasks p-10 flex space-x-5">
    <% if(files.length > 0){ %>
        <% files.forEach(function(val){ %>
                <div class="task w-72 px-3 py-4 rounded-md bg-zinc-800 text-white">
                    <h1 class="text-2xl tracking-tighter"><%= val %></h1>
                    <div class="flex w-full justify-between items-center mt-3">
                        <a class="text-blue-600 inline-block" href="/files/<%= val%>">Read more</a>  
                        <a class="text-yellow-600 inline-block" href="/edit/<%= val%>">Edit</a>  

                    </div>
                </div>
        <% }) %>
    <% } else { %>
        <h3 class="mt-5 text-white">No task available..</h3>
    <% } %>

 </div>
</div>
</body>
</html>